# 14330, no 1433: evita chocar con una instancia nativa de SQL Server que ya
# pueda estar escuchando en el puerto por defecto (ver docker-compose.yml).
DB_SERVER=localhost,14330
DB_NAME=distribuidora_dj
DB_USER=sa
# Requiere mayuscula, minuscula, numero y simbolo (minimo 8 caracteres): la usa
# tambien el contenedor de SQL Server (docker-compose.yml) como MSSQL_SA_PASSWORD.
DB_PASSWORD=Changeme123*
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TRUSTED_CONNECTION=no

# Envio de codigos de desbloqueo/recuperacion de clave. Normalmente se configura desde la
# app (Configuracion > Correo) y queda guardado en la base; estas variables solo sirven de
# respaldo mientras no se haya configurado ahi. Con Gmail: App Password de 16
# caracteres (Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contraseñas de
# aplicaciones) -- no la clave normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=yes

# Licenciamiento (ver licencias/README.md). Si LICENCIA_URL o LICENCIA_PUBLIC_KEY quedan
# vacios, el chequeo de licencia queda apagado (desarrollo/tests). En el ejecutable
# empaquetado estos valores se hornean en la app y el .env se ignora.
LICENCIA_URL=
LICENCIA_PUBLIC_KEY=

# Rol de esta instalacion (lo fija el instalador): SERVIDOR (activa y renueva la licencia, aloja
# SQL Server) o ESTACION (se conecta al servidor; solo lee el estado de licencia).
MODO_INSTALACION=SERVIDOR
